{
  "name": "pbgo",
  "version": "0.0.1-rc.3",
  "description": "PocketBase container runner",
  "author": {
    "name": "Ben Allfree",
    "github": "benallfree"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/benallfree/pbgo"
  },
  "homepage": "https://github.com/benallfree/pbgo",
  "type": "module",
  "bin": {
    "pbgo": "dist/cli.js"
  },
  "scripts": {
    "update": "bun run update-versions.ts",
    "build": "bun run build.ts",
    "bundle": "bunx tsdown --config tsdown.config.ts",
    "dev": "bunx tsdown --config tsdown.config.ts --watch",
    "prepare": "bun run bundle",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "files": [
    "dist/",
    "versions.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "tsdown": "^0.13.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "printWidth": 120,
    "tabWidth": 2,
    "semi": false
  }
}
